<Project>
  <PropertyGroup>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Auto-select plugin target framework based on the layout of $(DnspyHome).
      dnSpy-net-win64       (modern self-contained .NET build) ships netstandard.dll in bin/
                            => parse "tfm" from dnSpy.runtimeconfig.json (works for net8/9/10/...)
                            => append "-windows" (dnSpy is WPF)
                            => fall back to net8.0-windows if detection fails
      dnSpy-net-framework   (.NET Framework 4.8)                does NOT ship netstandard.dll
                            => net48
    Override either with -p:DnspyKind=net|netframework or -p:TargetFramework=...
  -->
  <PropertyGroup>
    <DnspyKind Condition="'$(DnspyKind)' == '' AND '$(DnspyHome)' != '' AND Exists('$(DnspyHome)\bin\netstandard.dll')">net</DnspyKind>
    <DnspyKind Condition="'$(DnspyKind)' == ''">netframework</DnspyKind>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DnspyKind)' == 'net'">
    <_DnspyRuntimeConfigPath>$(DnspyHome)\bin\dnSpy.runtimeconfig.json</_DnspyRuntimeConfigPath>
    <_DnspyRuntimeConfigPath Condition="!Exists('$(_DnspyRuntimeConfigPath)')">$(DnspyHome)\bin\dnSpy.Console.runtimeconfig.json</_DnspyRuntimeConfigPath>
    <_DnspyRuntimeConfigContent Condition="Exists('$(_DnspyRuntimeConfigPath)')">$([System.IO.File]::ReadAllText($(_DnspyRuntimeConfigPath)))</_DnspyRuntimeConfigContent>
    <_DnspyDetectedTfm Condition="'$(_DnspyRuntimeConfigContent)' != ''">$([System.Text.RegularExpressions.Regex]::Match($(_DnspyRuntimeConfigContent), `"tfm"\s*:\s*"(net[0-9]+\.[0-9]+)"`).Groups[1].Value)</_DnspyDetectedTfm>
    <DnspyDefaultTfm Condition="'$(_DnspyDetectedTfm)' != ''">$(_DnspyDetectedTfm)-windows</DnspyDefaultTfm>
    <DnspyDefaultTfm Condition="'$(DnspyDefaultTfm)' == ''">net8.0-windows</DnspyDefaultTfm>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DnspyKind)' == 'netframework'">
    <DnspyDefaultTfm>net48</DnspyDefaultTfm>
  </PropertyGroup>
</Project>
